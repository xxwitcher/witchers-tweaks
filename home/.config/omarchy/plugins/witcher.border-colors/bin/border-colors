#!/bin/bash
# Border colors for the looks module: the three-color active gradient and the
# inactive color, kept per machine in ~/.config/witchers-tweaks/border.conf
# (read by hypr/witchers-tweaks.lua) and mirrored into the Omarchy shell template so
# bar popups, notifications and the lock screen match the windows.
#
#   border-colors get                        print "light main accent inactive" (hex)
#   border-colors preview L M A I            show colors on the windows now, unsaved
#   border-colors revert                     back to the saved colors
#   border-colors set L M A I                save and apply everywhere
#   border-colors reset                      back to the default purple and save
#   border-colors shell-apply                write the shell template, refresh the theme if needed
#   border-colors shell-remove               take the template back out (installer removal)
#
# Colors are six hex digits, with or without a leading #.

set -euo pipefail

defaults=(c4b5fd a855f7 da70d6 5b3a7a)
conf_dir="$HOME/.config/witchers-tweaks"
conf="$conf_dir/border.conf"
template="$HOME/.config/omarchy/themed/shell.hyprland.toml.tpl"
generated="$HOME/.local/state/omarchy/current/theme/shell.toml"
marker="# witchers-tweaks: generated by border-colors"
# What the dotfiles version of this script wrote; treated as ours too.
old_marker="# witcher-tweaks: generated by border-colors"

# The template is ours when either version of this script wrote it.
ours() {
  grep -qsF "$marker" "$template" || grep -qsF "$old_marker" "$template"
}

die() { echo "border-colors: $*" >&2; exit 1; }

# Four validated colors from the arguments, lower case, no #.
parse() {
  (( $# == 4 )) || die "need four colors: light main accent inactive"
  local c out=()
  for c in "$@"; do
    c=${c#\#}
    [[ $c =~ ^[0-9a-fA-F]{6}$ ]] || die "not a color: $c"
    out+=("${c,,}")
  done
  echo "${out[*]}"
}

current() {
  local active="" inactive="" key value
  if [[ -f $conf ]]; then
    while IFS='=' read -r key value; do
      key=${key//[[:space:]]/}
      case $key in
        active) active=$value ;;
        inactive) inactive=${value//[[:space:]]/} ;;
      esac
    done <"$conf"
  fi
  local a out
  read -ra a <<<"$active"
  # A damaged file falls back to the defaults rather than failing.
  if (( ${#a[@]} == 3 )) && out=$(parse "${a[@]}" "${inactive:-${defaults[3]}}" 2>/dev/null); then
    echo "$out"
  else
    echo "${defaults[*]}"
  fi
}

lua_border() {
  printf '{ active = { "%s", "%s", "%s" }, inactive = "%s" }' "$@"
}

preview() {
  local parsed c
  parsed=$(parse "$@") || exit 1
  read -ra c <<<"$parsed"
  hyprctl eval "_G.witcher_border = $(lua_border "${c[@]}"); hl.config({ general = { col = { inactive_border = \"rgba(${c[3]}aa)\" } } })" >/dev/null
}

# Hyprland's config reads the file again; unsaved preview colors go.
revert() {
  hyprctl reload >/dev/null
}

write_template() {
  local c
  read -ra c <<<"$(current)"
  # A file of the user's own (no marker, not an old link into a dotfiles
  # checkout) is kept aside rather than overwritten.
  if [[ -e $template || -L $template ]] && ! ours \
    && ! [[ -L $template && $(readlink "$template") == */home/.config/omarchy/themed/shell.hyprland.toml.tpl ]]; then
    mv "$template" "$template.bak.$(date +%s)"
    echo "backup   ${template/#"$HOME"/\~}"
  fi
  mkdir -p "$(dirname "$template")"
  local stops="" i
  for i in 0 0 0 1 1 1 2 2; do stops+="rgba(${c[i]}ee) "; done
  local tmp="$template.tmp.$$"
  cat >"$tmp" <<EOF
$marker from ~/.config/witchers-tweaks/border.conf;
# change the colors with Setup > Witcher's Tweaks > Configure > Borders.
# Merged over the [hyprland] section of every theme's generated shell.toml.
# Bar popups, notifications, the lock screen and password prompts use
# active-border, so this gives them the same gradient as the window border.
[hyprland]
active-border            = "${stops}45deg"
active-border-foreground = "{{ shell_gradient hyprland_active_border foreground }}"
EOF
  rm -f "$template"
  mv "$tmp" "$template"
}

# Rebuilds the theme when its shell.toml doesn't carry the template's gradient
# yet. `omarchy theme refresh` keeps the current background.
refresh_theme() {
  local wanted
  wanted=$(grep '^active-border ' "$template" 2>/dev/null | sed 's/^active-border *= *//')
  if [[ -n $wanted ]] && grep -qsF "$wanted" "$generated"; then
    echo "ok       shell theme"
  else
    omarchy theme refresh >/dev/null
    echo "refreshed shell theme"
  fi
}

save() {
  local parsed c
  parsed=$(parse "$@") || exit 1
  read -ra c <<<"$parsed"
  mkdir -p "$conf_dir"
  printf 'active=%s %s %s\ninactive=%s\n' "${c[@]}" >"$conf.tmp.$$"
  mv "$conf.tmp.$$" "$conf"
  write_template
  hyprctl reload >/dev/null 2>&1 || true
  refresh_theme
}

shell_apply() {
  if ours; then
    local before
    before=$(cat "$template")
    write_template
    [[ $(cat "$template") == "$before" ]] && echo "ok       ${template/#"$HOME"/\~}" || echo "set      ${template/#"$HOME"/\~}"
  else
    write_template
    echo "set      ${template/#"$HOME"/\~}"
  fi
  refresh_theme
}

# Removal: the template goes (a backup of the user's own comes back), the
# saved colors go, and the theme is rebuilt without the gradient.
shell_remove() {
  if ours; then
    rm -f "$template"
    local backup
    backup=$(ls -1d "$template".bak.* 2>/dev/null | sort -V | tail -1 || true)
    if [[ -n $backup && ! -L $backup ]]; then
      mv "$backup" "$template"
      echo "restored ${template/#"$HOME"/\~}"
    else
      echo "removed  ${template/#"$HOME"/\~}"
    fi
    omarchy theme refresh >/dev/null
    echo "refreshed shell theme"
  else
    echo "ok       ${template/#"$HOME"/\~} (not ours)"
  fi
  if [[ -f $conf ]]; then
    rm -f "$conf"
    rmdir "$conf_dir" 2>/dev/null || true
    echo "removed  ~/.config/witchers-tweaks/border.conf"
  fi
}

case "${1:-}" in
  get) current ;;
  preview) shift; preview "$@" ;;
  revert) revert ;;
  set) shift; save "$@" ;;
  reset) save "${defaults[@]}" ;;
  shell-apply) shell_apply ;;
  shell-remove) shell_remove ;;
  *) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
